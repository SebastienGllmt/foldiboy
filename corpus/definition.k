module SM83-CORE-SYNTAX
  imports BOOL-SYNTAX
  imports INT-SYNTAX

  syntax AluOp
  syntax FlagSet
  syntax UnaryOp

  syntax AluOp ::= "adc" [symbol(aluAdc), format(%1)]
  syntax AluOp ::= "add" [symbol(aluAdd), format(%1)]
  syntax AluOp ::= "and" [symbol(aluAnd), format(%1)]
  syntax AluOp ::= "cp" [symbol(aluCp), format(%1)]
  syntax AluOp ::= "or" [symbol(aluOr), format(%1)]
  syntax AluOp ::= "sbc" [symbol(aluSbc), format(%1)]
  syntax AluOp ::= "sub" [symbol(aluSub), format(%1)]
  syntax AluOp ::= "xor" [symbol(aluXor), format(%1)]
  // The flag register: zero, subtract, half-carry and carry.
  // 
  // Only `PUSH AF` and `POP AF` see it as a byte (`FlagByte`, `ByteFlags`).
  syntax FlagSet ::= "flags" "(" Bool "," Bool "," Bool "," Bool ")" [symbol(flags)]
  // Complement the carry flag.
  syntax UnaryOp ::= "ccf" [symbol(unaryCcf), format(%1)]
  // Complement.
  syntax UnaryOp ::= "cpl" [symbol(unaryCpl), format(%1)]
  // Decimal adjust after a BCD addition or subtraction.
  syntax UnaryOp ::= "daa" [symbol(unaryDaa), format(%1)]
  syntax UnaryOp ::= "dec" [symbol(unaryDec), format(%1)]
  syntax UnaryOp ::= "inc" [symbol(unaryInc), format(%1)]
  syntax UnaryOp ::= "res" Int [symbol(unaryResetBit), format(%1 %2)]
  syntax UnaryOp ::= "rl" [symbol(unaryRl), format(%1)]
  syntax UnaryOp ::= "rla" [symbol(unaryRla), format(%1)]
  syntax UnaryOp ::= "rlc" [symbol(unaryRlc), format(%1)]
  // The accumulator rotates: as `RLC`, `RRC`, `RL`, `RR`, but Z is cleared.
  syntax UnaryOp ::= "rlca" [symbol(unaryRlca), format(%1)]
  syntax UnaryOp ::= "rr" [symbol(unaryRr), format(%1)]
  syntax UnaryOp ::= "rra" [symbol(unaryRra), format(%1)]
  syntax UnaryOp ::= "rrc" [symbol(unaryRrc), format(%1)]
  syntax UnaryOp ::= "rrca" [symbol(unaryRrca), format(%1)]
  // Set the carry flag.
  syntax UnaryOp ::= "scf" [symbol(unaryScf), format(%1)]
  syntax UnaryOp ::= "set" Int [symbol(unarySetBit), format(%1 %2)]
  syntax UnaryOp ::= "sla" [symbol(unarySla), format(%1)]
  syntax UnaryOp ::= "sra" [symbol(unarySra), format(%1)]
  syntax UnaryOp ::= "srl" [symbol(unarySrl), format(%1)]
  syntax UnaryOp ::= "swap" [symbol(unarySwap), format(%1)]
endmodule

module SM83-CORE
  imports BOOL
  imports INT
  imports SM83-CORE-SYNTAX

  // The flags of `ADD HL, rr`: Z unchanged, carries out of bits 11 and 15.
  syntax FlagSet ::= "addHlFlags" "(" Int "," Int "," FlagSet ")" [symbol(addHlFlags), function, total]
  // The new flags after `A <- A op b`.
  syntax FlagSet ::= "aluFlags" "(" AluOp "," Int "," Int "," FlagSet ")" [symbol(aluFlags), function, total]
  // The new `A` after `A <- A op b`.
  syntax Int ::= "aluResult" "(" AluOp "," Int "," Int "," FlagSet ")" [symbol(aluResult), function, total]
  // The new flags after `BIT bit, value`; the value itself is unchanged.
  syntax FlagSet ::= "bitFlags" "(" Int "," Int "," FlagSet ")" [symbol(bitFlags), function, total]
  // The low 8 bits of an integer.
  syntax Int ::= "byte" "(" Int ")" [symbol(byte), function, total]
  // The flags of a flag byte; bits 3 to 0 are ignored.
  syntax FlagSet ::= "byteFlags" "(" Int ")" [symbol(byteFlags), function, total]
  // The carry flag, as `0` or `1`.
  syntax Int ::= "carryIn" "(" FlagSet ")" [symbol(carryIn), function, total]
  // Whether the carry flag is set.
  syntax Bool ::= "carrySet" "(" FlagSet ")" [symbol(carrySet), function, total]
  // The correction `DAA` adds after an addition or subtracts after a
  // subtraction.
  syntax Int ::= "daaCorrection" "(" Int "," FlagSet ")" [symbol(daaCorrection), function, total]
  // Whether `DAA` corrects the high digit, which is also its carry out.
  // 
  // After a subtraction a digit is corrected only if it borrowed; after an
  // addition, also if it exceeds 9.
  syntax Bool ::= "daaHigh" "(" Int "," FlagSet ")" [symbol(daaHigh), function, total]
  // Whether `DAA` corrects the low digit.
  syntax Bool ::= "daaLow" "(" Int "," FlagSet ")" [symbol(daaLow), function, total]
  // `1` for `true`, `0` for `false`.
  syntax Int ::= "flagBit" "(" Bool ")" [symbol(flagBit), function, total]
  // The flag byte of `F`: Z, N, H, C in bits 7 to 4, bits 3 to 0 zero.
  syntax Int ::= "flagByte" "(" FlagSet ")" [symbol(flagByte), function, total]
  // Whether the half-carry flag is set.
  syntax Bool ::= "halfCarrySet" "(" FlagSet ")" [symbol(halfCarrySet), function, total]
  // The high byte of a 16-bit value.
  syntax Int ::= "high" "(" Int ")" [symbol(high), function, total]
  // The low byte of a 16-bit value.
  syntax Int ::= "low" "(" Int ")" [symbol(low), function, total]
  // The 16-bit value with high byte `high` and low byte `low`.
  syntax Int ::= "pair" "(" Int "," Int ")" [symbol(pair), function, total]
  // The flags of a rotate or shift: Z from the result, C from the bit
  // shifted out.
  syntax FlagSet ::= "shiftFlags" "(" Int "," Bool ")" [symbol(shiftFlags), function, total]
  // A byte read as a two's-complement offset in `-128..=127`.
  syntax Int ::= "signed" "(" Int ")" [symbol(signed), function, total]
  // The flags of `SP + e`: carries out of bits 3 and 7 of the low byte,
  // adding the offset byte unsigned.
  syntax FlagSet ::= "spOffsetFlags" "(" Int "," Int ")" [symbol(spOffsetFlags), function, total]
  // Whether the subtract flag is set.
  syntax Bool ::= "subtractSet" "(" FlagSet ")" [symbol(subtractSet), function, total]
  // The new flags after `v <- op v`.
  syntax FlagSet ::= "unaryFlags" "(" UnaryOp "," Int "," FlagSet ")" [symbol(unaryFlags), function, total]
  // The new value after `v <- op v`.
  syntax Int ::= "unaryResult" "(" UnaryOp "," Int "," FlagSet ")" [symbol(unaryResult), function, total]
  // The low 16 bits of an integer.
  syntax Int ::= "word" "(" Int ")" [symbol(word), function, total]
  // Whether the zero flag is set.
  syntax Bool ::= "zeroSet" "(" FlagSet ")" [symbol(zeroSet), function, total]

