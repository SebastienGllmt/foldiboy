endmodule

module SM83-EVENTS-SYNTAX
  imports INT-SYNTAX

  syntax CpuEvent

  // A machine cycle with no bus access.
  syntax CpuEvent ::= "idle" [symbol(eventIdle), format(%1)]
  // The CPU read `value` from `addr`.
  syntax CpuEvent ::= "read" "(" Int "," Int ")" [symbol(eventRead), format(%1%2%3%4 %5%6)]
  // The CPU wrote `value` to `addr`. The byte it replaced is not part of the
  // event: it is memory at `addr` before the write, which any consumer that
  // needs it derives.
  syntax CpuEvent ::= "write" "(" Int "," Int ")" [symbol(eventWrite), format(%1%2%3%4 %5%6)]
endmodule

module SM83-EVENTS
  imports SM83-EVENTS-SYNTAX
endmodule
