  // KRS foldiboy-sm83/src/machine.rs: Machine
  configuration
    <k> # boundary </k>
    <regs> $REGS:Map </regs>
    <f> $F:FlagSet </f>
    <pc> $PC:Int </pc>
    <sp> $SP:Int </sp>
    <ime> $IME:Bool </ime>
    <eiPending> $EI_PENDING:Bool </eiPending>
    <halted> $HALTED:Bool </halted>
    <haltBug> $HALT_BUG:Bool </haltBug>
    <w unobservable=""> $W:Int </w>
    <z unobservable=""> $Z:Int </z>
    <rom> $ROM:Bytes </rom>
    <romEnd> lengthBytes($ROM:Bytes) </romEnd>
    <memory> $MEMORY:Map </memory>
    <bus> .List </bus>


  // KRS foldiboy-sm83/src/execute.rs: add_hl
  rule [add-hl]:
    <k> add hl , Pair:RegPair => # idle ~> # setPair ( pair ( h , l ) , word ( hl ( Registers:Map ) +Int pairValue ( Pair:RegPair , Registers:Map , Flags:FlagSet , Sp:Int ) ) ) ... </k>
    <regs> Registers:Map </regs>
    <f> Flags:FlagSet => addHlFlags ( hl ( Registers:Map ) , pairValue ( Pair:RegPair , Registers:Map , Flags:FlagSet , Sp:Int ) , Flags:FlagSet ) </f>
    <sp> Sp:Int </sp>
  // KRS foldiboy-sm83/src/execute.rs: add_sp_offset
  rule [add-sp-offset]:
    <k> add sp , e => # loadZ ( n ) ~> # idle ~> # idle ~> # addSpZ ( sp ) ... </k>
  // KRS foldiboy-sm83/src/micro.rs: add_sp_z
  rule [add-sp-z]:
    <k> # addSpZ ( Dst:RegPair ) => # setPair ( Dst:RegPair , word ( Sp:Int +Int signed ( Offset:Int ) ) ) ... </k>
    <sp> Sp:Int </sp>
    <z> Offset:Int </z>
    <f> _ => spOffsetFlags ( Sp:Int , Offset:Int ) </f>
  // KRS foldiboy-sm83/src/micro.rs: alu_a
  rule [alu-a]:
    <k> # aluA ( Op:AluOp ) => .K ... </k>
    <regs> Registers:Map => Registers:Map [ a <- aluResult ( Op:AluOp , {Registers:Map [ a ]}:>Int , Value:Int , Flags:FlagSet ) ] </regs>
    <z> Value:Int </z>
    <f> Flags:FlagSet => aluFlags ( Op:AluOp , {Registers:Map [ a ]}:>Int , Value:Int , Flags:FlagSet ) </f>
  // KRS foldiboy-sm83/src/execute.rs: alu8
  rule [alu8]:
    <k> Op:AluOp a , Src:Operand8 => # loadZ ( Src:Operand8 ) ~> # aluA ( Op:AluOp ) ... </k>
  // KRS foldiboy-sm83/src/interrupt.rs: boundary_dispatch
  rule [boundary-dispatch]:
    <k> # boundary => # dispatch ~> # boundary ... </k>
    <halted> Halted:Bool </halted>
    <ime> Ime:Bool </ime>
    <eiPending> _ => false </eiPending>
    <memory> Memory:Map </memory>
    requires (notBool Halted:Bool) andThenBool dispatches ( Ime:Bool , Memory:Map )
  // KRS foldiboy-sm83/src/interrupt.rs: boundary_fetch
  rule [boundary-fetch]:
    <k> # boundary => # fetch ~> # boundary ... </k>
    <halted> Halted:Bool </halted>
    <ime> Ime:Bool => Ime:Bool orElseBool Pending:Bool </ime>
    <eiPending> Pending:Bool => false </eiPending>
    <memory> Memory:Map </memory>
    requires (notBool Halted:Bool) andThenBool (notBool dispatches ( Ime:Bool , Memory:Map ))
  // KRS foldiboy-sm83/src/interrupt.rs: boundary_halted
  rule [boundary-halted]:
    <k> # boundary => # idle ~> # boundary ... </k>
    <halted> Halted:Bool </halted>
    <memory> Memory:Map </memory>
    requires Halted:Bool andThenBool (notBool interruptRequested ( Memory:Map ))
  // KRS foldiboy-sm83/src/interrupt.rs: boundary_wake
  rule [boundary-wake]:
    <k> # boundary ... </k>
    <halted> Halted:Bool => false </halted>
    <memory> Memory:Map </memory>
    requires Halted:Bool andThenBool interruptRequested ( Memory:Map )
  // KRS foldiboy-sm83/src/execute.rs: call
  rule [call]:
    <k> call Cond:Cond , nn => # loadZ ( n ) ~> # loadW ( n ) ~> # callIf ( Cond:Cond ) ... </k>
  // KRS foldiboy-sm83/src/micro.rs: call_not_taken
  rule [call-not-taken]:
    <k> # callIf ( Cond:Cond ) => .K ... </k>
    <f> Flags:FlagSet </f>
    requires notBool holds ( Cond:Cond , Flags:FlagSet )
  // KRS foldiboy-sm83/src/micro.rs: call_taken
  rule [call-taken]:
    <k> # callIf ( Cond:Cond ) => # idle ~> # writeByte ( word ( Sp:Int -Int 1 ) , high ( Pc:Int ) ) ~> # writeByte ( word ( Sp:Int -Int 2 ) , low ( Pc:Int ) ) ... </k>
    <pc> Pc:Int => pair ( High:Int , Low:Int ) </pc>
    <sp> Sp:Int => word ( Sp:Int -Int 2 ) </sp>
    <w> High:Int </w>
    <z> Low:Int </z>
    <f> Flags:FlagSet </f>
    requires holds ( Cond:Cond , Flags:FlagSet )
  // KRS foldiboy-sm83/src/micro.rs: check_bit
  rule [check-bit]:
    <k> # checkBit ( Bit:Int ) => .K ... </k>
    <z> Value:Int </z>
    <f> Flags:FlagSet => bitFlags ( Bit:Int , Value:Int , Flags:FlagSet ) </f>
